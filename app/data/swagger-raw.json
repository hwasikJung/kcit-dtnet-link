                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/sqiapi/addr/addr_clean/sqi": {
      "get": {
        "summary": "자체주소 정제 (형식만 정제)",
        "description": "자체주소정제",
        "tags": [
          "주소정제"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "input_addr",
            "required": true,
            "description": "텍스트 주소",
            "schema": {
              "type": "string",
              "default": "서울특별시 강남구 논현로64길 7(역삼동 776-8번지, 역삼청소년수련관  ) 역삼청소년수련관"
            }
          },
          {
            "in": "query",
            "name": "isRemoveNextLine",
            "required": false,
            "description": "줄바꿈 문자 삭제 여부(default true)",
            "schema": {
              "type": "boolean",
              "default": true
            }
          },
          {
            "in": "query",
            "name": "isChageMultiSpaceToSingle",
            "required": false,
            "description": "여러개 공백 한개로 바꿈 여부(default true)",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "isRemoveAfterParenthesis",
            "required": false,
            "description": "괄호 이후 삭제 여부(default true)",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "isRemoveAfterComma",
            "required": false,
            "description": "콤마 이후 삭제 여부(default true)",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "isRemoveRoGilSpace",
            "required": false,
            "description": "~로 n길 일 때 사이 공백 삭제 여부(default false)",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "정제된 주소",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
