    "/sqiapi/addr/transcoord": {
      "get": {
        "summary": "좌표계 변환 (SGIS, 자체 좌표변환 순)",
        "description": "SGIS 좌표변환 실패시, 자체 좌표변환 사용",
        "tags": [
          "좌표변환"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "src",
            "required": true,
            "description": "현재 좌표계, EPSG 코드 사용 \n- BESSEL 경/위도............EPSG:4004, EPSG:4162\n- WGS84 경/위도.............EPSG:4326, EPSG:4166\n- 서부원점(GRS80)...........EPSG:5185\n- 중부원점(GRS80)...........EPSG:5181, EPSG:5186\n- 동부원점(GRS80)...........EPSG:5187\n- 동해(울릉)원점(GRS80).....EPSG:5188\n- UTM-K (GRS80)............EPSG:5179\n- Google Mercator..........EPSG:900913 \n",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "dst",
            "required": true,
            "description": "변환할 좌표계, EPSG 코드",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "x",
            "required": true,
            "description": "x값",
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "y",
            "required": true,
            "description": "y값",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "변환된 좌표 x, y",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
