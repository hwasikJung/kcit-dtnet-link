    "/sqiapi/addr/addr_clean": {
      "get": {
        "summary": "주소 정제 (실제 주소 매칭으로 정제)",
        "description": "SGIS, Kakao, 주소기반산업지원서비스, 자체주소정제 순",
        "tags": [
          "주소정제"
        ],
        "parameters": [
          {
            "in": "query",
            "name": "input_addr",
            "required": true,
            "description": "텍스트 주소",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
